// Downscales scaled resolve buffer data back to 1x resolution for CPU readback.
// Operates on the 32x32-texel tiled layout used by the Xbox 360. One thread
// group processes one tile; each thread produces one or more output dwords.
//
// Picks the top-left texel of each scale_x * scale_y block, or, when
// xe_downscale_half_pixel_offset is set, the (scale/2, scale/2) texel within
// each block - the one closest to the unscaled pixel center.
//
// The xesl byte buffer stores whole dwords only and there's no group-shared
// memory, so the work is organized per output dword: for sub-dword formats the
// owning thread gathers the texels packed into the dword directly from source.

#include "../../ui/shaders/xesl.xesli"

push_const_begin_xe(b0, space0)
  uint xe_downscale_scale_x;          // 1 to kMaxDrawResolutionScaleAlongAxis
  uint xe_downscale_scale_y;          // 1 to kMaxDrawResolutionScaleAlongAxis
  uint xe_downscale_pixel_size_log2;  // 0=8bit, 1=16bit, 2=32bit, 3=64bit
  uint xe_downscale_tile_count;       // Number of 32x32 tiles to process.
  uint xe_downscale_source_offset_bytes;  // Byte offset into the source buffer.
  // When non-zero, sample from (scale/2, scale/2) within each scaled block
  // instead of (0, 0).
  uint xe_downscale_half_pixel_offset;
push_const_end_xe

byte_buffer_align4_declare_xe(xe_resolve_source, set=0, binding=0, t0, space0)
byte_buffer_align4_wo_declare_xe(xe_resolve_dest, set=0, binding=1, u0, space0)

// 128 threads per group - the recommended size and the Vulkan minimum for
// maxComputeWorkGroupInvocations. A tile has 256..2048 output dwords depending
// on the pixel size, so each thread strides over several of them.
#define LOCAL_SIZE_X_XE 128
#define LOCAL_SIZE_Y_XE 1
#define LOCAL_SIZE_Z_XE 1
entry_bindings_begin_compute_xe
  push_const_binding_xe(buffer(0))
  entry_binding_next_xe
  byte_buffer_binding_xe(xe_resolve_source, buffer(1))
  entry_binding_next_xe
  byte_buffer_wo_binding_xe(xe_resolve_dest, buffer(2))
entry_bindings_end_inputs_begin_compute_xe
  entry_in_group_id_xe
  entry_input_next_xe
  entry_in_local_thread_index_xe
entry_inputs_end_code_begin_compute_xe
{
  uint tile_index = in_group_id_xe.x;
  if (tile_index >= push_const_xe(xe_downscale_tile_count)) {
    return;
  }

  uint pixel_size_log2 = push_const_xe(xe_downscale_pixel_size_log2);
  uint scale_xy =
      push_const_xe(xe_downscale_scale_x) * push_const_xe(xe_downscale_scale_y);
  uint tile_size_1x = (32u * 32u) << pixel_size_log2;
  uint tile_size_scaled = tile_size_1x * scale_xy;
  // Number of output dwords in a 1x tile (256, 512, 1024 or 2048).
  uint tile_dwords = tile_size_1x >> 2u;

  // Offset, in source bytes, of the block texel to keep.
  uint block_sample_bytes = 0u;
  if (push_const_xe(xe_downscale_half_pixel_offset) != 0u && scale_xy > 1u) {
    uint offset_x = push_const_xe(xe_downscale_scale_x) >> 1u;
    uint offset_y = push_const_xe(xe_downscale_scale_y) >> 1u;
    block_sample_bytes =
        (offset_x + offset_y * push_const_xe(xe_downscale_scale_x))
        << pixel_size_log2;
  }

  uint tile_src_base =
      push_const_xe(xe_downscale_source_offset_bytes) +
      tile_index * tile_size_scaled + block_sample_bytes;
  uint tile_dst_base = tile_index * tile_size_1x;

  // Stride over the tile's output dwords, 128 per pass.
  for (uint dword_index = in_local_thread_index_xe; dword_index < tile_dwords;
       dword_index += 128u) {
    uint dst_dword_bytes = tile_dst_base + (dword_index << 2u);

    if (pixel_size_log2 == 2u) {
      // 32bpp: one source texel per output dword.
      uint src_bytes = tile_src_base + ((dword_index * scale_xy) << 2u);
      byte_buffer_align4_store4_xe(
          xe_resolve_dest, dst_dword_bytes,
          byte_buffer_align4_load4_xe(xe_resolve_source, src_bytes));
    } else if (pixel_size_log2 == 3u) {
      // 64bpp: one texel spans two output dwords.
      uint texel_index = dword_index >> 1u;
      uint half_index = dword_index & 1u;
      uint src_bytes = tile_src_base +
                       ((texel_index * scale_xy) << 3u) + (half_index << 2u);
      byte_buffer_align4_store4_xe(
          xe_resolve_dest, dst_dword_bytes,
          byte_buffer_align4_load4_xe(xe_resolve_source, src_bytes));
    } else {
      // 8bpp/16bpp: several kept texels are packed into one output dword. Each
      // lives at the start of its own scaled block in the source.
      uint texels_per_dword = 4u >> pixel_size_log2;
      uint first_texel_index = dword_index * texels_per_dword;
      uint component_bits = 8u << pixel_size_log2;
      uint component_mask = (1u << component_bits) - 1u;
      uint packed = 0u;
      for (uint i = 0u; i < texels_per_dword; ++i) {
        uint src_bytes = tile_src_base +
                         (((first_texel_index + i) * scale_xy)
                          << pixel_size_log2);
        uint src_word =
            byte_buffer_align4_load4_xe(xe_resolve_source, src_bytes);
        uint component =
            (src_word >> ((src_bytes & 3u) << 3u)) & component_mask;
        packed |= component << (i * component_bits);
      }
      byte_buffer_align4_store4_xe(xe_resolve_dest, dst_dword_bytes, packed);
    }
  }
}
entry_code_end_compute_xe
